generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model categories {
  id         Int      @id @default(autoincrement())
  user_id    Int
  name       String   @db.VarChar(100)
  color      String?  @db.VarChar(20)
  icon       String?  @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_categories_user")
  tasks      tasks[]

  @@unique([user_id, name], map: "uq_categories_user_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tasks {
  id           Int           @id @default(autoincrement())
  user_id      Int
  category_id  Int?
  title        String        @db.VarChar(255)
  notes        String?
  status       task_status   @default(TODO)
  priority     task_priority @default(MEDIUM)
  deadline     DateTime?     @db.Timestamptz(6)
  completed_at DateTime?     @db.Timestamptz(6)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @default(now()) @db.Timestamptz(6)
  categories   categories?   @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_tasks_category")
  users        users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tasks_user")

  @@index([category_id], map: "idx_tasks_category")
  @@index([user_id, deadline], map: "idx_tasks_user_deadline")
  @@index([user_id, status], map: "idx_tasks_user_status")
}

model users {
  id            Int          @id @default(autoincrement())
  name          String       @db.VarChar(100)
  email         String       @unique @db.VarChar(255)
  password_hash String       @db.VarChar(255)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @default(now()) @db.Timestamptz(6)
  categories    categories[]
  tasks         tasks[]
}

enum task_priority {
  LOW
  MEDIUM
  HIGH
}

enum task_status {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}
